rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function firmado() {
      return request.auth != null;
    }
    function esAdmin() {
      return firmado()
        && exists(/databases/$(database)/documents/acceso/admin)
        && get(/databases/$(database)/documents/acceso/admin).data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/controlAccesos/MARIA)
          || get(/databases/$(database)/documents/controlAccesos/MARIA).data.bloqueado != true);
    }
    function ficha() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function esTrabajador() {
      return firmado()
        && request.auth.token.accesoControlado == true
        && ficha().rol == "trabajador"
        && ficha().activo == true
        && ficha().idEmpleado is string
        && empleadoActivo(ficha().idEmpleado)
        && (!exists(/databases/$(database)/documents/controlAccesos/$(ficha().idEmpleado))
          || get(/databases/$(database)/documents/controlAccesos/$(ficha().idEmpleado)).data.bloqueado != true);
    }
    function esTerminal() {
      return firmado()
        && ficha().rol == "terminal"
        && ficha().activo == true;
    }
    function permiso() {
      return get(/databases/$(database)/documents/operacion/config).data.permissions[ficha().idEmpleado];
    }
    function empresaDelEmpleado() {
      return get(/databases/$(database)/documents/empleados/$(ficha().idEmpleado)).data.empresa_codigo;
    }
    function correoDeMaria() {
      return firmado()
        && request.auth.token.email.lower() == "maria@acceso.reypez.app";
    }
    function movimientoDeTurno(valor) {
      return valor == "ENTRADA"
        || valor == "SALIDA_A_COMER"
        || valor == "REGRESO_DE_COMER"
        || valor == "SALIDA_FINAL";
    }
    function diaGuatemala(ms) {
      return int((ms - 6 * 60 * 60 * 1000) / (24 * 60 * 60 * 1000));
    }
    function marcaVigente(datos) {
      return datos.fecha_ms is int
        && datos.fecha_dia is int
        && datos.fecha_dia == diaGuatemala(datos.fecha_ms)
        && datos.fecha_local is string
        && datos.fecha_ms <= request.time.toMillis() + 15 * 60 * 1000
        && datos.fecha_ms >= request.time.toMillis() - 20 * 60 * 60 * 1000
        && datos.id_registro is string
        && datos.id_empleado is string
        && datos.empresa_codigo is string
        && movimientoDeTurno(datos.movimiento);
    }
    function empleadoActivo(id) {
      return exists(/databases/$(database)/documents/empleados/$(id))
        && (
          !get(/databases/$(database)/documents/empleados/$(id)).data.keys().hasAny(["estatus"])
          || get(/databases/$(database)/documents/empleados/$(id)).data.estatus == "Activo"
        );
    }
    function hayCursor(idEmpleado) {
      return exists(/databases/$(database)/documents/secuenciaAsistencia/$(idEmpleado));
    }
    function cursor(idEmpleado) {
      return get(/databases/$(database)/documents/secuenciaAsistencia/$(idEmpleado)).data;
    }
    function diaNuevo(idEmpleado, datos) {
      return !hayCursor(idEmpleado) || cursor(idEmpleado).fecha_dia != datos.fecha_dia;
    }
    function sigueSecuencia(idEmpleado, datos) {
      return diaNuevo(idEmpleado, datos)
        ? datos.movimiento == "ENTRADA"
        : cursor(idEmpleado).ultimo == "SALIDA_FINAL" && datos.movimiento == "ENTRADA"
          || cursor(idEmpleado).ultimo == "ENTRADA"
            && (datos.movimiento == "SALIDA_A_COMER" || datos.movimiento == "SALIDA_FINAL")
          || cursor(idEmpleado).ultimo == "SALIDA_A_COMER"
            && datos.movimiento == "REGRESO_DE_COMER"
          || cursor(idEmpleado).ultimo == "REGRESO_DE_COMER"
            && datos.movimiento == "SALIDA_FINAL";
    }
    function secuenciaActualizada(datos) {
      return existsAfter(/databases/$(database)/documents/secuenciaAsistencia/$(datos.id_empleado))
        && getAfter(/databases/$(database)/documents/secuenciaAsistencia/$(datos.id_empleado)).data.ultimo == datos.movimiento
        && getAfter(/databases/$(database)/documents/secuenciaAsistencia/$(datos.id_empleado)).data.fecha_dia == datos.fecha_dia
        && getAfter(/databases/$(database)/documents/secuenciaAsistencia/$(datos.id_empleado)).data.registroId == datos.id_registro
        && getAfter(/databases/$(database)/documents/secuenciaAsistencia/$(datos.id_empleado)).data.idEmpleado == datos.id_empleado;
    }
    function marcajeOperativo(datos) {
      return marcaVigente(datos)
        && empleadoActivo(datos.id_empleado)
        && get(/databases/$(database)/documents/empleados/$(datos.id_empleado)).data.empresa_codigo == datos.empresa_codigo
        && sigueSecuencia(datos.id_empleado, datos)
        && secuenciaActualizada(datos);
    }
    function bitacoraDeTrabajador(datos) {
      return esTrabajador()
        && datos.createdBy == ficha().idEmpleado
        && datos.company == permiso().company
        && datos.type in permiso().logs
        && empresaDelEmpleado() == datos.company;
    }

    match /acceso/admin {
      allow get: if true;
      allow list: if false;
      allow create: if correoDeMaria()
        && request.resource.data.keys().hasOnly(["uid"])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/acceso/admin);
      allow update, delete: if false;
    }

    match /usuarios/{uid} {
      allow get: if esAdmin() || esTerminal() || (firmado() && request.auth.uid == uid);
      allow list: if esAdmin() || esTerminal();
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["idEmpleado"]);
      allow create, delete: if false;
    }

    match /empleados/{id} {
      allow read: if esAdmin() || esTerminal()
        || (esTrabajador() && (resource.data.id_empleado == ficha().idEmpleado || resource.data.empresa_codigo == permiso().company));
      allow write: if esAdmin();
    }
    match /horarios/{id} {
      allow read: if esAdmin() || esTerminal();
      allow write: if esAdmin();
    }
    match /bitacoras/{id} {
      allow read: if esAdmin()
        || (esTrabajador()
          && resource.data.company == permiso().company
          && resource.data.type in permiso().logs);
      allow create: if esAdmin() || bitacoraDeTrabajador(request.resource.data);
      allow update, delete: if esAdmin();
    }
    // Nómina privada de administración. Registros serializados, hasta 240 KB;
    // el lector valida recibos y conciliación. Nunca contiene permisos ni roles.
    function nominaValida(d, id) {
      return d.keys().hasAll(['id','empresa_codigo','empresa_nombre','desde','hasta','anio','mes','numeroPeriodo','archivo','huella','registrosJson','revision','creadoEn','actualizadoEn','creadoMs','actualizadoMs','actualizadoPor'])
        && d.keys().hasOnly(['id','empresa_codigo','empresa_nombre','desde','hasta','anio','mes','numeroPeriodo','archivo','huella','registrosJson','revision','creadoEn','actualizadoEn','creadoMs','actualizadoMs','actualizadoPor'])
        && d.id is string && d.id == id
        && d.empresa_codigo in ['ALLAN','EDGAR','ESTUARDO']
        && d.id == d.empresa_codigo + '_' + d.desde + '_' + d.hasta
        && d.empresa_nombre is string && d.empresa_nombre.size() > 0 && d.empresa_nombre.size() <= 200
        && d.desde is string && d.hasta is string
        && d.desde.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.hasta.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.desde <= d.hasta
        && d.anio is int && d.anio >= 2000 && d.anio <= 2100
        && d.mes is int && d.mes >= 1 && d.mes <= 12
        && d.numeroPeriodo is int && d.numeroPeriodo >= 0 && d.numeroPeriodo <= 366
        && d.archivo is string && d.archivo.size() > 0 && d.archivo.size() <= 200
        && d.huella is string && d.huella.matches('^[a-f0-9]{64}$')
        && d.registrosJson is string && d.registrosJson.size() > 0 && d.registrosJson.size() <= 240000
        && d.revision is int && d.revision > 0
        && d.creadoEn is string && d.creadoEn.size() == 24
        && d.actualizadoEn is string && d.actualizadoEn.size() == 24
        && d.creadoMs is int && d.actualizadoMs is int && d.creadoMs <= d.actualizadoMs
        && d.actualizadoMs >= request.time.toMillis() - 5 * 60 * 1000
        && d.actualizadoMs <= request.time.toMillis() + 60 * 1000
        && d.actualizadoPor == 'MARIA';
    }
    match /nominas/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin() && nominaValida(request.resource.data,id)
        && request.resource.data.revision == 1
        && request.resource.data.creadoMs == request.resource.data.actualizadoMs;
      allow update: if esAdmin() && nominaValida(request.resource.data,id)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.creadoEn == resource.data.creadoEn
        && request.resource.data.creadoMs == resource.data.creadoMs
        && request.resource.data.actualizadoMs >= resource.data.actualizadoMs
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id','empresa_codigo','desde','hasta','anio','mes']);
      allow delete: if false;
    }

    match /empresas/{codigo} {
      allow read, write: if esAdmin();
    }
    match /mantenimiento/{id} {
      allow read, write: if esAdmin();
    }
    match /revisiones/{id} {
      allow read, write: if esAdmin();
    }
    match /auditoria/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        || (esTrabajador()
          && request.resource.data.by == ficha().idEmpleado
          && request.resource.data.keys().hasOnly(["id", "action", "by", "when"]));
      allow update, delete: if esAdmin();
    }
    match /asistencia/{id} {
      allow read: if esAdmin() || esTerminal()
        || (esTrabajador() && resource.data.id_empleado == ficha().idEmpleado);
      allow create: if esAdmin()
        || (request.resource.data.id_registro == id
          && (esTerminal()
            || (esTrabajador()
              && request.resource.data.id_empleado == ficha().idEmpleado
              && request.resource.data.empresa_codigo == permiso().company))
          && marcajeOperativo(request.resource.data));
      allow update, delete: if esAdmin();
    }
    match /secuenciaAsistencia/{idEmpleado} {
      allow read: if esAdmin() || esTerminal()
        || (esTrabajador() && ficha().idEmpleado == idEmpleado);
      allow create, update: if esAdmin()
        || (request.resource.data.keys().hasOnly(["ultimo", "fecha", "fecha_dia", "registroId", "idEmpleado"])
          && request.resource.data.idEmpleado == idEmpleado
          && movimientoDeTurno(request.resource.data.ultimo)
          && (esTerminal() || (esTrabajador() && ficha().idEmpleado == idEmpleado))
          && existsAfter(/databases/$(database)/documents/asistencia/$(request.resource.data.registroId))
          && getAfter(/databases/$(database)/documents/asistencia/$(request.resource.data.registroId)).data.movimiento == request.resource.data.ultimo
          && getAfter(/databases/$(database)/documents/asistencia/$(request.resource.data.registroId)).data.fecha_dia == request.resource.data.fecha_dia
          && getAfter(/databases/$(database)/documents/asistencia/$(request.resource.data.registroId)).data.id_empleado == idEmpleado);
      allow delete: if esAdmin();
    }
    match /alertas/{id} {
      allow read: if esAdmin() || esTerminal();
      allow create: if esAdmin()
        || ((esTerminal()
            || (esTrabajador() && request.resource.data.id_empleado == ficha().idEmpleado))
          && request.resource.data.id_empleado is string
          && empleadoActivo(request.resource.data.id_empleado));
      allow update, delete: if esAdmin();
    }
    match /alertasSeguridad/{id} {
      allow read, update: if esAdmin();
      allow create, delete: if false;
    }
    match /controlAccesos/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }
    match /operacion/config {
      allow read: if esAdmin() || esTrabajador() || esTerminal();
      allow write: if esAdmin();
    }
    match /respaldos/{id} {
      allow read, write: if esAdmin();
    }
  }
}
