# Reservado para Firebase. Sin estas variables la aplicación sigue en localStorage.
# Nunca colocar cuentas de servicio ni claves privadas en variables VITE_*.
# Copia este archivo a .env y completa los valores de la app web (no los de Admin SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Correos sintéticos {id}@{dominio}. No son buzones reales; desactiva la verificación de correo.
VITE_FIREBASE_AUTH_EMAIL_DOMAIN=usuarios.reypez.local
# Solo para el emulador local. Déjalo vacío en producción.
VITE_FIREBASE_EMULADOR=
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199
# URL HTTPS de la función restablecerContrasena. Vacía hasta desplegarla.
VITE_FIREBASE_FUNCION_CONTRASENA=
