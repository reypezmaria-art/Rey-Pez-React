# Copia este archivo a .env y pega la configuración de la app web de Firebase.
# Si estas variables quedan vacías, la app sigue guardando en el navegador.
# Nunca colocar cuentas de servicio ni claves privadas en variables VITE_*.
# El dominio del correo interno debe coincidir con AUTH_EMAIL_DOMAIN de la función.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_AUTH_EMAIL_DOMAIN=acceso.reypez.app
# URL HTTPS del Worker gratuito, una vez publicado (sin credenciales).
VITE_ACCESO_API_URL=
