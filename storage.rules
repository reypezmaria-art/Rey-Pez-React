rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function cuentaExiste() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/cuentas/$(request.auth.uid));
    }
    function cuenta() {
      return firestore.get(/databases/(default)/documents/cuentas/$(request.auth.uid)).data;
    }
    function esAdmin() {
      return cuentaExiste()
        && cuenta().rol == 'admin'
        && cuenta().activo == true
        && cuenta().idEmpleado == 'MARIA'
        && firestore.exists(/databases/(default)/documents/indiceCuentas/MARIA)
        && firestore.get(/databases/(default)/documents/indiceCuentas/MARIA).data.uid == request.auth.uid;
    }
    function esTrabajadorDe(empresa) {
      return cuentaExiste()
        && cuenta().activo == true
        && cuenta().rol == 'trabajador'
        && cuenta().empresa == empresa;
    }
    match /evidencias/{empresa}/{id}/{archivo} {
      allow read: if esAdmin() || esTrabajadorDe(empresa);
      allow write: if request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf')
        && (esAdmin() || esTrabajadorDe(empresa));
    }
  }
}
