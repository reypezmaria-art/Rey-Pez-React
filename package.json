{
  "name": "rey-pez-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "herramientas/prueba-editor-nomina"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "iniciar": "vite --config configuracion-vite.js --host 127.0.0.1",
    "compilar:editor": "node --max-old-space-size=4096 herramientas/prueba-editor-nomina/compilar.mjs --integrado",
    "compilar": "npm run compilar:editor && vite build --config configuracion-vite.js",
    "previsualizar": "vite preview --config configuracion-vite.js --host 127.0.0.1",
    "revisar-codigo": "eslint --config configuracion-eslint.js .",
    "formatear": "prettier --config configuracion-formato.json --write .",
    "comprobar-formato": "prettier --config configuracion-formato.json --check .",
    "probar": "node --test pruebas/*.prueba.js",
    "probar:reglas": "npx --yes firebase-tools@13 emulators:exec --only firestore,storage --project demo-rey-pez \"node --test pruebas/emulador/reglas.prueba.js\"",
    "probar:navegador": "playwright test --config configuracion-pruebas.js",
    "verificar": "npm run comprobar-formato && npm run revisar-codigo && npm run probar && npm run compilar",
    "vista-local": "npm run compilar && node herramientas/generarVistaLocal.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "3.10.1",
    "firebase": "^13.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
